{
  "$schema": "https://opencode.ai/v2/cli.json",
  "session": {
    "sidebar": "hide",
    "verbosity": "low"
  },
  "scroll": {
    "acceleration": false
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "terminal": {
    "copy": "select",
    "title": false
  },
  "diffs": {
    "view": "auto"
  },
  "tabs": {
    "scope": "cwd",
    "mode": "off"
  }
}
