{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "session": {
    "sidebar": "hide",
    "verbosity": "medium",
    "grouping": "none",
    "new_location": "launch"
  },
  "scroll": {
    "acceleration": false
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.6
  },
  "terminal": {
    "copy": "select",
    "title": true
  },
  "diffs": {
    "view": "auto"
  },
  "tabs": {
    "scope": "cwd",
    "mode": "off"
  }
}
